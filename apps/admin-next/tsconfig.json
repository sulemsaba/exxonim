{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "baseUrl": ".",
    "allowJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./.cache/tsconfig.app.tsbuildinfo",
    "incremental": true,
    "types": ["react", "react-dom"],
    "typeRoots": ["../../node_modules/@types"],
    "paths": {
      "@/*": ["src/*"],
      "@exxonim/admin-core": ["../../packages/admin-core/src/index.ts"],
      "@exxonim/admin-core/*": ["../../packages/admin-core/src/*"],
      "@exxonim/shared/*": ["../../packages/shared/src/*"],
      "src/*": ["src/*"]
    }
  },
  "include": ["src", "../../packages/admin-core/src", "../../packages/shared/src"],
  "exclude": ["node_modules"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
