{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@exxonim/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src", "../../packages/shared/src"],
  "exclude": [
    "src/pages/admin/**/*",
    "src/components/admin/**/*",
    "src/components/ProtectedRoute.tsx"
  ]
}
