{
  
  "name": "@exxonim/public",
  
  "private": true,
  
  "version": "0.1.0",
  
  "type": "module",
  
  "scripts": {
  
    
  "dev": "vite --port 5173",
  
    
  "build": "npm run fetch-fallback && tsc -b && npm run build:client && npm run build:server && npm run prerender",
  
    
  "build:client": "vite build",
  
    
  "build:server": "vite build --ssr src/app/entry-server.tsx --outDir dist/server",
  
    
  "fetch-fallback": "node scripts/fetchFallbackAssets.mjs",
  
    
  "prerender": "node scripts/prerender.mjs",
  
    
  "preview": "vite preview --port 4173",
  
    
  "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest --run",
    "test:watch": "vitest"
  
  },
  
  "dependencies": {
  
    
  "@exxonim/shared": "*",
  
    
  "@tanstack/react-query": "^5.59.0",
  
    
  "axios": "^1.7.7",
  
    
  "react": "^18.3.1",
  
    
  "react-dom": "^18.3.1"
  
  },
  
  "devDependencies": {
  
    
  "@tailwindcss/vite": "^4.0.0",
  
    
  "@testing-library/jest-dom": "^6.9.1",
  
    
  "@testing-library/react": "^16.3.2",
  
    
  "@types/node": "^22.10.1",
  
    
  "@types/react": "^18.3.7",
  
    
  "@types/react-dom": "^18.3.3",
  
    
  "@vitejs/plugin-react": "^4.7.0",
  
    
  "autoprefixer": "^10.4.20",
  
    
  "clsx": "^2.1.1",
  
    
  "jsdom": "^29.1.1",
  
    
  "lucide-react": "^1.14.0",
  
    
  "postcss": "^8.4.49",
  
    
  "tailwind-merge": "^3.5.0",
  
    
  "tailwindcss": "^4.0.0",
  
    
  "typescript": "^5.6.3",
  
    
  "vite": "^5.4.10",
  
    
  "vitest": "^4.1.5"
  
  }
}
