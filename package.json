{
  "name": "exxonim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:public": "npm run dev --workspace @exxonim/public",
    "dev:admin": "npm run dev --workspace @exxonim/admin-next",
    "dev:admin-legacy": "npm run dev --workspace @exxonim/admin",
    "dev:admin-next": "npm run dev --workspace @exxonim/admin-next",
    "build:public": "npm run build --workspace @exxonim/public",
    "build:admin": "npm run build --workspace @exxonim/admin-next",
    "build:admin-legacy": "npm run build --workspace @exxonim/admin",
    "build:admin-next": "npm run build --workspace @exxonim/admin-next",
    "preview:public": "npm run preview --workspace @exxonim/public",
    "preview:admin": "npm run preview --workspace @exxonim/admin-next",
    "preview:admin-legacy": "npm run preview --workspace @exxonim/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:deploy": "node scripts/build-deploy.mjs",
    "preview:deploy": "npm run build:deploy && node scripts/preview-deploy.mjs",
    "test:admin": "npm run test --workspace @exxonim/admin-next",
    "test:admin:watch": "npm run test:watch --workspace @exxonim/admin-next"
  }
}
